class Solution {
    public String longestCommonPrefix(String[] strs) {
        int min=Integer.MAX_VALUE;
        int n=strs.length;
        for (int i=0;i<n;i++){
            min=Math.min(min,strs[i].length());
        }
        StringBuilder s=new StringBuilder();
        for(int i=0;i<min;i++){
            Boolean flag=true;
            char c;
            c=strs[0].charAt(i);
            for(int j=1;j<strs.length;j++){
                if(strs[j].charAt(i)!=c){
                flag=false;
                break;
                }
            }
            if(flag){
                s.append(c);
            }else{
                break;
            }
        }
        return s.toString();
    }
}
